# Local Compose credentials. Set two different generated passwords (hex is URL-safe).
RAG_DB_OWNER_PASSWORD=
RAG_DB_APP_PASSWORD=
RAG_DB_PORT=5432
RAG_DATABASE_URL=postgresql://rag_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5432/enterprise_rag

RAG_APP_ID=enterprise-rag-demo
# Replace each value with a different randomly generated bearer token.
RAG_COLLECTION_TOKENS='{"course-demo":"REPLACE_WITH_COURSE_TOKEN","enterprise-demo":"REPLACE_WITH_ENTERPRISE_TOKEN"}'

# Ollama uses its native API. Use openai and the model provider's key/API base
# for each capability independently. Model artifacts are managed outside the repo.
RAG_CHAT_PROVIDER=ollama
RAG_CHAT_BASE_URL=http://127.0.0.1:11434
RAG_CHAT_MODEL=qwen3.5:9b
RAG_CHAT_API_KEY=

RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=nomic-embed-text:latest
RAG_EMBEDDING_REVISION=0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_DIMENSION=768
RAG_EMBEDDING_DOCUMENT_PREFIX="search_document: "
RAG_EMBEDDING_QUERY_PREFIX="search_query: "

RAG_CHAT_TIMEOUT=90
RAG_EMBEDDING_TIMEOUT=30
